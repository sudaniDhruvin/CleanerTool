<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <!-- Background shape with rounded corners -->
    <item>
        <shape android:shape="rectangle" android:useLevel="false" xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="#2196F3" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Mask ensures ripple is clipped to the same rounded corners -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle" android:useLevel="false" xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="#2196F3" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</ripple>
